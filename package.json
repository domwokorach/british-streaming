  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ops": "node --test tests/ops/*.test.mjs",
    "test:motion": "node --experimental-strip-types --no-warnings --test tests/motion/*.test.mjs",
    "slo:rules": "node scripts/slo/generate-rules.mjs",
    "slo:rules:check": "node scripts/slo/generate-rules.mjs --check",
    "typecheck": "tsc --noEmit",
    "start:standalone": "mkdir -p .next/standalone/.next/static .next/standalone/public && cp -R .next/static/. .next/standalone/.next/static/ && cp -R public/. .next/standalone/public/ && node .next/standalone/server.js",
    "test:e2e": "playwright test"
  },
